# Copy this file to .env on a developer machine or place equivalent values in
# /etc/tibos/hrms-api.env on production. Never commit real values.

# Database
URL_DB=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/hrm_db
SQL_ECHO=false

# Authentication — generate independent, long random values
ACCESS_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
REFRESH_SECRET_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET

# Public application URLs
FRONTEND_URL=https://hrm.example.com
API_URL=https://hrm-api.example.com

# Legacy SMTP mail path
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SENDER_EMAIL=hr@example.com

# Upload storage (Cloudinary is optional)
UPLOADS_DIR=/srv/tibos/apps/hrms-api/shared/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI features
GEMINI_API_KEY=
MODEL=gemini-1.5-flash

# Birthday scheduler
BIRTHDAY_TIMEZONE=Asia/Kolkata
BIRTHDAY_SEND_HOUR=9
BIRTHDAY_SEND_MINUTE=0

# Optional SSO runtime state location
SSO_CODES_PATH=/var/lib/tibos/hrms-api/sso_codes.json
